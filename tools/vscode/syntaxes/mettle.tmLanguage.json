{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mettle",
  "scopeName": "source.mettle",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#declarations"},
    {"include": "#generic-references"},
    {"include": "#calls"},
    {"include": "#quoted-identifiers"},
    {"include": "#keywords"},
    {"include": "#numbers"},
    {"include": "#types"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mettle",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.mettle",
          "match": "//.*$"
        },
        {"include": "#block-comment"}
      ]
    },
    "block-comment": {
      "name": "comment.block.mettle",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{"include": "#block-comment"}]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.mettle",
          "begin": "\\b(?:br|r)(#*)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.double.interpolated.mettle",
          "begin": "\\bf\"",
          "end": "\"|$",
          "patterns": [
            {"include": "#escapes"},
            {
              "name": "constant.character.escape.mettle",
              "match": "\\{\\{|\\}\\}"
            },
            {"include": "#format-hole"}
          ]
        },
        {
          "name": "string.quoted.double.mettle",
          "begin": "(?:\\bb)?\"",
          "end": "\"|$",
          "patterns": [{"include": "#escapes"}]
        },
        {
          "name": "string.quoted.single.mettle",
          "begin": "(?:\\bb)?'",
          "end": "'|$",
          "patterns": [{"include": "#escapes"}]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mettle",
          "match": "\\\\(?:[nrt0\\\\'\"]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.mettle",
          "match": "\\\\."
        }
      ]
    },
    "format-hole": {
      "name": "meta.interpolation.mettle",
      "begin": "\\{",
      "end": "\\}|$",
      "patterns": [
        {"include": "#expression-braces"},
        {"include": "$self"}
      ]
    },
    "expression-braces": {
      "begin": "\\{",
      "end": "\\}|$",
      "patterns": [
        {"include": "#expression-braces"},
        {"include": "$self"}
      ]
    },
    "quoted-identifiers": {
      "name": "variable.other.mettle",
      "match": "`[A-Za-z_][A-Za-z0-9_]*`"
    },
    "declarations": {
      "patterns": [
        {
          "begin": "\\b(fn|macro)\\s+(`[A-Za-z_][A-Za-z0-9_]*`|[A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {"name": "storage.type.function.mettle"},
            "2": {"name": "entity.name.function.mettle"}
          },
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [{"include": "#generic-parameters"}]
        },
        {
          "begin": "\\b(type|enum|interface|union|alias)\\s+(`[A-Za-z_][A-Za-z0-9_]*`|[A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {"name": "storage.type.mettle"},
            "2": {"name": "entity.name.type.mettle"}
          },
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [{"include": "#generic-parameters"}]
        },
        {
          "begin": "(?<!\\.)\\b(?:(extend)|(for))\\b(?=\\s*<)",
          "beginCaptures": {
            "1": {"name": "storage.modifier.mettle"},
            "2": {"name": "keyword.control.mettle"}
          },
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [{"include": "#generic-parameters"}]
        },
        {
          "match": "\\b(let|var)\\s+(`[A-Za-z_][A-Za-z0-9_]*`|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "storage.type.mettle"},
            "2": {"name": "variable.other.mettle"}
          }
        },
        {
          "name": "entity.other.attribute-name.mettle",
          "match": "@[A-Za-z_][A-Za-z0-9_:]*"
        }
      ]
    },
    "generic-parameters": {
      "name": "meta.generic.mettle",
      "begin": "<(?![<=])",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.generic.mettle"}
      },
      "end": ">",
      "endCaptures": {
        "0": {"name": "punctuation.definition.generic.mettle"}
      },
      "patterns": [{"include": "#generic-contents"}]
    },
    "generic-references": {
      "name": "meta.generic.mettle",
      "comment": "Balance same-line arguments, protecting const braces, before checking type/expression followers. Declarations use their own multiline context.",
      "begin": "(?<![A-Za-z0-9_`])(?:(\\.)\\s*)?([A-Za-z_][A-Za-z0-9_]*|`[A-Za-z_][A-Za-z0-9_]*`)\\s*(?=(?<generic><(?:[A-Za-z0-9_`\\s.,:;?+=\\[\\]()]|\\g<generic>|(?<constant>\\{(?:[^{}\"']|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|\\g<constant>)*\\}))+>)\\s*(?:[().,;\\]}:{?=+]|\\b(?:where|implements|from|throws|not)\\b|$))(<)",
      "beginCaptures": {
        "1": {"name": "punctuation.separator.mettle"},
        "2": {
          "patterns": [
            {"include": "#types"},
            {"name": "entity.name.function.mettle", "match": "`?[A-Za-z_][A-Za-z0-9_]*`?"}
          ]
        },
        "5": {"name": "punctuation.definition.generic.mettle"}
      },
      "end": ">",
      "endCaptures": {
        "0": {"name": "punctuation.definition.generic.mettle"}
      },
      "patterns": [{"include": "#generic-contents"}]
    },
    "generic-contents": {
      "patterns": [
        {"include": "#comments"},
        {"include": "#strings"},
        {"include": "#const-expression"},
        {"include": "#generic-brackets"},
        {"include": "#generic-parameters"},
        {"include": "#quoted-identifiers"},
        {"include": "#keywords"},
        {"include": "#numbers"},
        {"include": "#types"},
        {"include": "#operators"}
      ]
    },
    "const-expression": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {"include": "#const-expression"},
        {"include": "$self"}
      ]
    },
    "generic-brackets": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {"include": "#generic-brackets"},
        {"include": "#const-expression"},
        {"include": "$self"}
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "variable.other.metavariable.mettle",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.macro.mettle",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*!\\s*[({\\[])"
        },
        {
          "match": "(\\.\\s*)(`[A-Za-z_][A-Za-z0-9_]*`|[a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {"name": "punctuation.separator.mettle"},
            "2": {"name": "entity.name.function.mettle"}
          }
        },
        {
          "name": "entity.name.function.mettle",
          "match": "\\b(?!(?:if|while|for|match|fn|pub|async|unsafe|const|init|drop|present|success|failure|self|Self|from)\\b)[a-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.mettle",
          "match": "\\b(?:true|false|none)\\b"
        },
        {
          "name": "support.function.variant.mettle",
          "match": "\\b(?:present|success|failure)\\b"
        },
        {
          "name": "variable.language.mettle",
          "match": "\\b(?:self|Self)\\b"
        },
        {
          "name": "keyword.control.mettle",
          "match": "\\b(?:if|else|while|loop|for|in|match|break|continue|return|throw|throws|try|capture|await|label)\\b"
        },
        {
          "name": "storage.type.mettle",
          "match": "\\b(?:fn|let|var|type|enum|interface|union|alias|macro)\\b"
        },
        {
          "name": "storage.modifier.mettle",
          "match": "\\b(?:pub|copy|read|mut|take|async|unsafe|extern|static|const|init|drop|heap|shared|weak|local|pinned|as|where|region|implements|receiver|module|import)\\b"
        },
        {
          "name": "storage.modifier.mettle",
          "match": "(?<!\\.)\\bextend\\b(?=\\s*(?:<|[A-Za-z_`]))"
        },
        {
          "name": "storage.modifier.mettle",
          "match": "(?<!\\.)\\b(?:from|any|some|not)\\b(?=\\s+[A-Za-z_`]|\\s*\\()"
        },
        {
          "match": "([:+])\\s*(unsized)\\b",
          "captures": {
            "1": {"patterns": [{"include": "#operators"}]},
            "2": {"name": "storage.modifier.mettle"}
          }
        },
        {
          "match": "(?<=:)\\s*(format)\\b",
          "captures": {
            "1": {"name": "storage.modifier.mettle"}
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mettle",
          "match": "(?<!\\.)\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?:f32|f64)?|[eE][+-]?[0-9](?:_?[0-9])*(?:f32|f64)?|f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.mettle",
          "match": "\\b(?:0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0b[01](?:_?[01])*|0o[0-7](?:_?[0-7])*|[0-9](?:_?[0-9])*)(?:[iu](?:8|16|32|64|128|size))?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.mettle",
          "match": "\\b(?:bool|char|[iu](?:8|16|32|64|128|size)|f32|f64|Unit|Never|Text|String|Copy|Sized|Unpin|Transferable|Shareable|Static|ptr)\\b"
        },
        {
          "name": "constant.other.mettle",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "entity.name.type.mettle",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mettle",
          "match": "\\?\\?|\\?\\.|\\.\\.=|\\.\\.\\.|\\.\\.|=>|&&|\\|\\||<<=?|>>=?|[+*/%&|^!=<>-]=?|\\?"
        },
        {
          "name": "punctuation.separator.mettle",
          "match": "[{}\\[\\](),;:.]"
        }
      ]
    }
  }
}
