name: "generated-git"
version: "0.1.0"
kind: "library"
build { script: "build.mt" }
dependencies {
    outside { path: "../outside" }
    helper {
        path: "nested/helper"
        features: ["target"]
        default_features: false
    }
}
macros {
    git_value {
        source: "macros/git_value.mt"
        api: 1
    }
}
