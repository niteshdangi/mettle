// Root of the native `core` library: no allocator and no operating system.
// Names declared here must not collide with compiler built-in modules
// (`ptr`, `mem`, `cell`, `sync`, `pin`, `arch`, `intrinsics`, `ffi`, `marker`).
pub module any;
pub module borrow;
pub module clone;
pub module cmp;
pub module default;
pub module float;
pub module fmt;
pub module future;
pub module hash;
pub module iter;
pub module num;
pub module ops;
pub module option;
pub module outcome;
pub module panic;
pub module slice;
pub module text;
